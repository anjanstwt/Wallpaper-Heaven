{
  "name": "@repo/db",
  "version": "1.0.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "prisma generate && tsc -b",
    "postinstall": "prisma generate",
    "generate": "prisma generate",
    "migrate": "node --env-file=../../.env node_modules/prisma/build/index.js migrate dev",
    "db:push": "node --env-file=../../.env node_modules/prisma/build/index.js db push",
    "studio": "node --env-file=../../.env node_modules/prisma/build/index.js studio"
  },
  "dependencies": {
    "@prisma/client": "^6.9.0",
    "dotenv": "^16.5.0",
    "prisma": "^6.9.0"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^24.0.0"
  }
}