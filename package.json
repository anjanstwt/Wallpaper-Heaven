{
  "name": "allpaperpaper",
  "private": true,
  "scripts": {
    "build": "turbo run build --filter=!backend",
    "dev": "turbo run dev --filter=!backend",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "turbo": "^2.5.3",
    "typescript": "5.8.2"
  },
  "packageManager": "pnpm@10.5.2",
  "engines": {
    "node": "24.x"
  }
}